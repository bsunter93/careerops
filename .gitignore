# Personal data. Never commit these.
# config.json    - identity, watchlist, candid per-company notes
# profile.md     - candidate profile
# master.json    - your resume: name, phone, email, every claim you make
# dashboard.html - a full projection of your database, embedded as JSON
config.json
profile.md
resume/master.json
resume/.variant_*.json
dashboard.html

# A backup suffix defeats every pattern above: config.json is ignored,
# config.json.bak is not. Four such files reached the public repo this way,
# including a 3MB copy of the whole database. Match the suffixes, not just
# the names.
*.bak
*.bak-*
*.backup
*.orig
*.old
*~
*.docx
*.pdf
careerops.db
careerops.db-wal
careerops.db-shm

# Credentials
credentials.json
token.json
.env

# Noise
*.log
__pycache__/
.venv/
.DS_Store
demo.db
demo.db-wal
demo.db-shm
demo-dashboard.html

# The classifier corpus is real mail: subjects, senders and bodies.
corpus/

# Working briefs, not part of the published project
notes-*.md
